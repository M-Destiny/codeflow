{
  "name": "codeflow",
  "builds": [
    { "src": "server/**/*", "use": "@vercel/node" },
    { "src": "client/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/dist/index.js" },
    { "src": "/socket.io/(.*)", "dest": "server/dist/index.js" },
    { "src": "/(.*)", "dest": "client/dist/index.html" }
  ],
  "env": {
    "PORT": "3001",
    "OPENAI_API_KEY": "@openai-api-key",
    "REDIS_URL": "@redis-url"
  },
  "regions": ["iad1", "sfo1", "fra1"],
  "functions": {
    "server/dist/index.js": {
      "memory": 512,
      "maxDuration": 30
    }
  }
}
