{
  "name": "codeflow",
  "version": "0.1.0",
  "description": "Real-time collaborative code editor with CRDT, WebRTC, and AI pair programming",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "codeflow": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:client": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.18.3",
    "monaco-editor": "^0.47.0",
    "peerjs": "^1.5.4",
    "pino": "^8.19.0",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5",
    "uuid": "^9.0.1",
    "y-monaco": "^0.1.4",
    "y-protocols": "^1.0.6",
    "y-webrtc": "^10.3.0",
    "y-websocket": "^1.5.4",
    "yjs": "^13.6.14",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/node": "^20.11.30",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/uuid": "^9.0.8",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.4.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vitest": "^1.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
